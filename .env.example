# 复制为 .env 后按需修改。真实密钥不要提交到代码库。
NODE_ENV=development
PORT=3000

# SQLite 数据文件路径（相对 prisma/ 目录）
DATABASE_URL="file:../data/suteng.db"

# 认证密钥：至少 32 位随机字符串，生产环境必须更换
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-random-48-byte-string"
ACCESS_TOKEN_TTL=28800
REFRESH_TOKEN_TTL=6048000

# 上传目录与大小限制
UPLOAD_DIR="./data/uploads"
UPLOAD_MAX_MB=5

APP_NAME="宿藤家居 ERP"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="change-me-on-first-login"
BOOTSTRAP_ADMIN_NAME="管理员"

LOG_LEVEL=info
